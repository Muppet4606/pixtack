            Gdk.Cursor.new_from_name(w.get_display(), "crosshair")))
        scroller = Gtk.ScrolledWindow()
        scroller.add(self.area)

        # Bottom bar: status on the left, main actions centred, shortcuts on the right.
        actions = Gtk.ActionBar()
