        self.set_icon_name("pixtack")
        self.set_resizable(False)
        hb = Gtk.HeaderBar(show_close_button=True)
        hb.props.title = APP_NAME
        hb.props.subtitle = "v" + VERSION
        self.set_titlebar(hb)
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        grid.set_border_width(12)
        for i, (label, action, tip) in enumerate(self.ACTIONS):
            b = Gtk.Button(label=label)
            b.set_tooltip_text(tip)
            b.set_size_request(160, 44)
            b.connect("clicked", self.on_action, action)
            grid.attach(b, i % 2, i // 2, 1, 1)
        row = len(self.ACTIONS) // 2
        grid.attach(Gtk.Label(label="Delay (seconds)", xalign=0), 0, row, 1, 1)
        self.delay = Gtk.SpinButton.new_with_range(0, 30, 1)
        grid.attach(self.delay, 1, row, 1, 1)
        keys = Gtk.Button(label="Keyboard shortcuts…")
        keys.connect("clicked", lambda *_: ShortcutsDialog(self))
        grid.attach(keys, 0, row + 1, 2, 1)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        prompt = self._shortcut_prompt()
        if prompt:
            box.pack_start(prompt, False, False, 0)
        box.pack_start(grid, False, False, 0)
        self.add(box)
        self.connect("destroy", lambda *_: app.release())
        self.connect("key-press-event", lambda _w, ev: Gdk.keyval_name(ev.keyval) == "Escape"
                     and (self.destroy() or True))

    def _shortcut_prompt(self):
        """Offer to turn on global shortcuts, which are off after a fresh install."""
        try:
            if (not gnome_shortcuts_supported() or any(gnome_shortcut_bindings().values())
                    or load_config().get("shortcut_prompt_dismissed")):
                return None
        except GLib.Error:
            return None
        bar = Gtk.InfoBar(message_type=Gtk.MessageType.INFO)
        lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=38, label=(
            "Global shortcuts are off. Turn them on to capture from anywhere with "
            "Super+Shift+S (region), F (full screen), G (GIF) and R (video)."))
        bar.get_content_area().add(lbl)
        bar.add_button("_Enable", 1)
        bar.add_button("Not now", 2)
        bar.connect("response", self._on_prompt)
        return bar

    def _on_prompt(self, bar, response):
        if response == 1:
            skipped = apply_gnome_shortcuts() or []
            if skipped:
                error_dialog("Some shortcuts were not set because their keys are already in use:\n"
                             + "\n".join("%s: used by '%s'" % s for s in skipped)
                             + "\n\nChoose other keys in Keyboard shortcuts.", self)
            else:
                notify("Global shortcuts enabled", "Try Super+Shift+S for a region screenshot.")
        else:
            cfg = load_config()
            cfg["shortcut_prompt_dismissed"] = True
            save_config(cfg)
        bar.destroy()

    def on_action(self, _b, action):
        if action == "open":
            dlg = Gtk.FileChooserNative.new("Open image", self, Gtk.FileChooserAction.OPEN,
                                            "_Open", "_Cancel")
            f = Gtk.FileFilter()
            f.set_name("Images")
            f.add_pixbuf_formats()
            dlg.add_filter(f)
            if dlg.run() == Gtk.ResponseType.ACCEPT:
                self.app.open_file(dlg.get_filename())
                self.destroy()
            dlg.destroy()
            return
        delay = self.delay.get_value()
        self.hide()
        self.app.dispatch(action, delay)
        self.destroy()


class App:
    def __init__(self):
        self.holds = 0
        self.recorder = None

    def hold(self):
        self.holds += 1

    def release(self):
        self.holds -= 1
        if self.holds <= 0:
            GLib.idle_add(Gtk.main_quit)

    def fail(self, msg):
        if msg:
            error_dialog(msg)
        self.release()

    def dispatch(self, action, delay=0.0):
        if action in ("region", "full", "window"):
            self.capture(action, delay)
        elif action in ("gif", "video"):
            self.record(action == "gif", delay)

    def open_file(self, path):
        try:
            Editor(self, GdkPixbuf.Pixbuf.new_from_file(path), None)
        except GLib.Error as e:
            error_dialog("Could not open %s:\n%s" % (path, e.message))

    # ---- screenshots
    def capture(self, mode, delay=0.0):
        self.hold()
        GLib.timeout_add(int(delay * 1000) + 350, self._capture_now, mode)

    def _capture_now(self, mode):
        pb, err = capture_window() if mode == "window" else capture_desktop()
        if pb is None:
            self.fail(err)
        elif mode == "region":
            RegionSelector(pb, "Drag to select  ·  Enter: whole monitor  ·  Esc: cancel",
                           lambda r: self._region_done(pb, r))
        else:
            Editor(self, pb, mode)
            self.release()
        return False

    def _region_done(self, pb, res):
        if res:
            x, y, w, h = res["rect"]
            if w >= 1 and h >= 1:
                Editor(self, pb.new_subpixbuf(x, y, w, h).copy(), "region")
        self.release()

    # ---- recording
    def record(self, gif, delay=0.0):
        if self.recorder:
            self.recorder.stop()
            return
        pid = running_recorder_pid()
        if pid:
            os.kill(pid, signal.SIGUSR1)
            return
        self.hold()
        GLib.timeout_add(int(delay * 1000) + 350, self._record_select, gif)

    def _record_select(self, gif):
        pb, err = capture_desktop()
        if pb is None:
            self.fail(err)
            return False
        what = "GIF" if gif else "video"
        RegionSelector(pb, "Drag to select the %s area  ·  Enter: whole monitor  ·  Esc: cancel" % what,
                       lambda r: self._record_start(gif, r))
        return False

    def _record_start(self, gif, res):
        if not res:
            self.release()
            return
        self.recorder = Recorder(self, gif)
        self.recorder.begin(res)

    def on_stop_signal(self):
        if self.recorder:
            self.recorder.stop()
        return GLib.SOURCE_CONTINUE

    def on_terminate(self):
        if self.recorder:
            self.recorder.stop()
        else:
            Gtk.main_quit()
        return GLib.SOURCE_CONTINUE

    def linger_for_clipboard(self):
        """GTK owns the clipboard only while we run, so stay alive until something else copies."""
        self.hold()
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        state = {"done": False}

        def done(*_):
            if not state["done"]:
                state["done"] = True
                self.release()
            return False

        GLib.timeout_add(1000, lambda: (cb.connect("owner-change", done), False)[1])
        GLib.timeout_add_seconds(1800, done)


def running_recorder_pid():
    try:
        with open(PIDFILE) as fh:
            pid = int(fh.read().strip())
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            if b"pixtack" not in fh.read():
                return None
        return pid
    except (OSError, ValueError):
        return None


# --------------------------------------------------------------------------- GNOME shortcuts

SHORTCUTS = [("region", "Region screenshot", "--region", "<Shift><Super>s"),
             ("full", "Full-screen screenshot", "--full", "<Shift><Super>f"),
             ("gif", "Record GIF (start/stop)", "--gif", "<Shift><Super>g"),
             ("video", "Record video (start/stop)", "--video", "<Shift><Super>r")]
MEDIA_KEYS = "org.gnome.settings-daemon.plugins.media-keys"
KEY_PATH = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/pixtack-%s/"
GNOME_KEY_SCHEMAS = ["org.gnome.desktop.wm.keybindings", "org.gnome.shell.keybindings",
                     "org.gnome.mutter.keybindings", "org.gnome.mutter.wayland.keybindings",
                     MEDIA_KEYS]
ACCEL_MASK = int(Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK
                 | Gdk.ModifierType.MOD1_MASK | Gdk.ModifierType.SUPER_MASK)


def gnome_shortcuts_supported():
    source = Gio.SettingsSchemaSource.get_default()
    return source is not None and source.lookup(MEDIA_KEYS, True) is not None


def _custom(key):
    return Gio.Settings.new_with_path(MEDIA_KEYS + ".custom-keybinding", KEY_PATH % key)


def gnome_shortcut_bindings():
    """Current binding for each Pixtack shortcut, or None where it is not installed."""
    if not gnome_shortcuts_supported():
        return {}
    current = Gio.Settings.new(MEDIA_KEYS).get_strv("custom-keybindings")
    return {key: (_custom(key).get_string("binding") or None) if KEY_PATH % key in current else None
            for key, _n, _a, _d in SHORTCUTS}


def chosen_binding(key):
    default = {k: d for k, _n, _a, d in SHORTCUTS}[key]
    return load_config().get("global_keys", {}).get(key, default)


def remember_binding(key, binding):
    cfg = load_config()
    cfg.setdefault("global_keys", {})[key] = binding
    save_config(cfg)


def _norm(accel):
    key, mods = Gtk.accelerator_parse(accel or "")
    if not key:
        return None
    return (Gdk.keyval_to_lower(key), int(mods) & ACCEL_MASK)


def find_conflict(accel, ignore=()):
    """Name of the GNOME or custom shortcut already using accel, if any."""
    target = _norm(accel)
    source = Gio.SettingsSchemaSource.get_default()
    if not target or source is None:
        return None
    for schema in GNOME_KEY_SCHEMAS:
        sc = source.lookup(schema, True)
        if sc is None:
            continue
        settings = Gio.Settings.new(schema)
        for name in sc.list_keys():
            value = settings.get_value(name)
            kind = value.get_type_string()
            vals = value.unpack() if kind == "as" else [value.unpack()] if kind == "s" else []
            if any(isinstance(v, str) and _norm(v) == target for v in vals):
                return sc.get_key(name).get_summary() or name.replace("-", " ")
    media = Gio.Settings.new(MEDIA_KEYS) if source.lookup(MEDIA_KEYS, True) else None
    for path in (media.get_strv("custom-keybindings") if media else []):
        if any(path == KEY_PATH % k for k in ignore):
            continue
        cs = Gio.Settings.new_with_path(MEDIA_KEYS + ".custom-keybinding", path)
        if _norm(cs.get_string("binding")) == target:
            return cs.get_string("name") or "a custom shortcut"
    return None


def set_gnome_shortcut(key, binding):
    """Install (binding set) or remove (binding None) one Pixtack global shortcut."""
    name, arg = {k: (n, a) for k, n, a, _d in SHORTCUTS}[key]
    settings = Gio.Settings.new(MEDIA_KEYS)
    current = list(settings.get_strv("custom-keybindings"))
    path, cs = KEY_PATH % key, _custom(key)
    if binding:
        exe = shutil.which("pixtack") or os.path.abspath(sys.argv[0])
        cs.set_string("name", "Pixtack: " + name)
        cs.set_string("command", "%s %s" % (exe, arg))
        cs.set_string("binding", binding)
        if path not in current:
            current.append(path)
    else:
        if path in current:
            current.remove(path)
        for k in ("name", "command", "binding"):
            cs.reset(k)
    settings.set_strv("custom-keybindings", current)
    Gio.Settings.sync()


def apply_gnome_shortcuts(remove=False):
    """Enable or disable all. Returns skipped [(name, conflict)], or None if unsupported."""
    if not gnome_shortcuts_supported():
        return None
    skipped = []
    own = [k for k, _n, _a, _d in SHORTCUTS]
    for key, name, _arg, _default in SHORTCUTS:
        if remove:
            set_gnome_shortcut(key, None)
            continue
        binding = chosen_binding(key)
        clash = find_conflict(binding, ignore=own)
        if clash:
            skipped.append((name, clash))
        else:
            set_gnome_shortcut(key, binding)
    return skipped


def setup_shortcuts(remove=False):
    skipped = apply_gnome_shortcuts(remove)
    if skipped is None:
        print("GNOME settings schema not found; set shortcuts in your desktop's keyboard settings.")
        return 1
    if remove:
        print("Shortcuts removed.")
        return 0
    bindings = gnome_shortcut_bindings()
    for key, name, _arg, _default in SHORTCUTS:
        b = bindings.get(key)
        print("%-28s %s" % (name, b.replace("<", "").replace(">", "+") if b else "(not set)"))
    for name, clash in skipped:
        print("Skipped %s: key already used by '%s'." % (name, clash))
    print("Change keys from Pixtack's Keyboard shortcuts window (F1 in the editor).")
    return 0


def diagnose():
    """Print what Pixtack can see, for troubleshooting and bug reports."""
    env = os.environ.get
    print("Pixtack %s  (Python %s, GTK %d.%d.%d)" % (VERSION, sys.version.split()[0], Gtk.get_major_version(),
                                                 Gtk.get_minor_version(), Gtk.get_micro_version()))
    print("Executable:      %s" % (shutil.which("pixtack") or os.path.abspath(sys.argv[0])))
    print("Session:         %s  (WAYLAND_DISPLAY=%s, DISPLAY=%s)" % (
        env("XDG_SESSION_TYPE", "?"), env("WAYLAND_DISPLAY", "-"), env("DISPLAY", "-")))
    print("Desktop:         %s" % env("XDG_CURRENT_DESKTOP", "?"))
    for tool in ("ffmpeg", "ffprobe", "wl-copy", "xclip", "notify-send", "grim"):
        print("%-16s %s" % (tool + ":", "yes" if have(tool) else "no"))
    try:
        gi.require_version("Gst", "1.0")
        from gi.repository import Gst
        Gst.init(None)
        pw = "yes" if Gst.ElementFactory.find("pipewiresrc") else "no (install gstreamer1.0-pipewire)"
    except (ValueError, ImportError):
        pw = "no (install gir1.2-gstreamer-1.0)"
    print("GStreamer PipeWire: %s" % pw)
    try:
        version = Portal().get_property("org.freedesktop.portal.Screenshot", "version")
        print("Screenshot portal: %s" % ("version %s" % version if version else "not found"))
    except GLib.Error as e:
        print("Screenshot portal: error (%s)" % e.message)
    print()
    if not gnome_shortcuts_supported():
        print("Global shortcuts: GNOME settings not found on this desktop.")
    else:
        bindings = gnome_shortcut_bindings()
        own = [k for k, _n, _a, _d in SHORTCUTS]
        print("Global shortcuts:%s" % ("" if any(bindings.values()) else
                                       "  NOT ENABLED (open Keyboard shortcuts > Enable all)"))
        for key, name, arg, _default in SHORTCUTS:
            b = bindings.get(key)
            if not b:
                print("  %-27s off" % name)
                continue
            cmd = _custom(key).get_string("command")
            exe = cmd.split()[0] if cmd else ""
            problems = []
            if not exe or not os.access(exe, os.X_OK):
                problems.append("command not found: %r" % cmd)
            clash = find_conflict(b, ignore=own)
            if clash:
                problems.append("key also used by '%s'" % clash)
            print("  %-27s %-18s %s" % (name, b, "; ".join(problems) or "OK"))
    print()
    print("Log file: %s" % LOGFILE)
    try:
        with open(LOGFILE) as fh:
            tail = fh.readlines()[-8:]
        print("Last log lines:\n" + "".join("  " + line for line in tail).rstrip())
    except OSError:
        print("  (no log yet)")
    return 0


# --------------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="pixtack", description="Lightweight screenshot and recording tool.")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--region", action="store_true", help="capture a region")
    g.add_argument("--full", action="store_true", help="capture all monitors")
    g.add_argument("--window", action="store_true", help="capture the active window")
    g.add_argument("--gif", action="store_true", help="start or stop a GIF recording")
    g.add_argument("--video", action="store_true", help="start or stop a video recording")
    g.add_argument("--stop", action="store_true", help="stop the current recording")
    g.add_argument("--open", metavar="FILE", help="annotate an existing image")
    g.add_argument("--setup-shortcuts", action="store_true", help="add GNOME keyboard shortcuts")
    g.add_argument("--remove-shortcuts", action="store_true", help="remove Pixtack's GNOME shortcuts")
    g.add_argument("--diagnose", action="store_true", help="print setup details for bug reports")
    ap.add_argument("--delay", type=float, default=0.0, help="seconds to wait before capturing")
    ap.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    args = ap.parse_args()

    GLib.set_prgname("pixtack")
    GLib.set_application_name(APP_NAME)

    if args.stop or args.gif or args.video:
        pid = running_recorder_pid()
        if pid:
            os.kill(pid, signal.SIGUSR1)
            return 0
        if args.stop:
            print("No recording in progress.")
            return 1
    if args.diagnose:
        return diagnose()
    if args.setup_shortcuts or args.remove_shortcuts:
        return setup_shortcuts(remove=args.remove_shortcuts)
    setup_logging()

    app = App()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, app.on_stop_signal)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, app.on_terminate)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, app.on_terminate)

    if args.open:
        app.hold()
        app.open_file(args.open)
        GLib.idle_add(app.release)
    elif args.region or args.full or args.window:
        app.capture("region" if args.region else "full" if args.full else "window", args.delay)
    elif args.gif or args.video:
        app.record(args.gif, args.delay)
    else:
        Launcher(app).show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
