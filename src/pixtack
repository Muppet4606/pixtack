# --------------------------------------------------------------------------- helpers

def have(cmd):
    return shutil.which(cmd) is not None


def session_is_wayland():
    return (os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland"
            or bool(os.environ.get("WAYLAND_DISPLAY")))


def user_dir(kind, sub, fallback):
    base = GLib.get_user_special_dir(kind) or os.path.expanduser(fallback)
    path = os.path.join(base, sub)
    os.makedirs(path, exist_ok=True)
    return path


def shots_dir():
    return user_dir(GLib.UserDirectory.DIRECTORY_PICTURES, "Screenshots", "~/Pictures")


def videos_dir():
    return user_dir(GLib.UserDirectory.DIRECTORY_VIDEOS, "Pixtack", "~/Videos")


def stamp():
    return time.strftime("%Y-%m-%d_%H-%M-%S")


LOGFILE = os.path.join(GLib.get_user_cache_dir(), "pixtack", "pixtack.log")
PIDFILE = os.path.join(GLib.get_user_runtime_dir(), "pixtack-recorder.pid")
CONFIG = os.path.join(GLib.get_user_config_dir(), "pixtack", "settings.json")


def load_config():
    try:
        with open(CONFIG) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w") as fh:
            json.dump(cfg, fh)
    except OSError:
        pass


def notify(summary, body=""):
    if have("notify-send"):
        subprocess.Popen(["notify-send", "-a", APP_NAME, "-i", "pixtack", summary, body],
                         stdout=DEVNULL, stderr=DEVNULL)


def log(msg):
    """Timestamped line on stderr, which goes to the log file when launched without a terminal."""
    try:
        sys.stderr.write("%s [%d] %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), os.getpid(), msg))
        sys.stderr.flush()
    except (OSError, ValueError, AttributeError):
        pass


def setup_logging():
    """Record every launch, and send output to a log when there is no terminal (e.g. a shortcut)."""
    try:
        os.makedirs(os.path.dirname(LOGFILE), exist_ok=True)
        if os.path.exists(LOGFILE) and os.path.getsize(LOGFILE) > 512 * 1024:
            os.replace(LOGFILE, LOGFILE + ".old")
        interactive = sys.stderr is not None and sys.stderr.isatty()
        if not interactive:
            fd = os.open(LOGFILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            os.dup2(fd, 2)
            os.close(fd)
            sys.stderr = os.fdopen(2, "w", buffering=1)
        else:
            with open(LOGFILE, "a") as fh:
                fh.write("%s [%d] started %s (from a terminal)\n" % (
                    time.strftime("%Y-%m-%d %H:%M:%S"), os.getpid(), " ".join(sys.argv[1:]) or "launcher"))
    except OSError:
        interactive = True
    if not interactive:
        log("started %s session=%s desktop=%s" % (
            " ".join(sys.argv[1:]) or "launcher", os.environ.get("XDG_SESSION_TYPE", "?"),
            os.environ.get("XDG_CURRENT_DESKTOP", "?")))

    def hook(etype, value, tb):
        traceback.print_exception(etype, value, tb)
        notify("Pixtack hit an error", "%s: %s\nDetails are in %s" % (etype.__name__, value, LOGFILE))

    sys.excepthook = hook


def error_dialog(msg, parent=None):
    log("error: " + msg.replace("\n", " "))
    if not (sys.stderr and sys.stderr.isatty()):
        notify("Pixtack", msg)
    dlg = Gtk.MessageDialog(transient_for=parent, modal=True,
                            message_type=Gtk.MessageType.ERROR,
                            buttons=Gtk.ButtonsType.CLOSE, text=APP_NAME)
    dlg.format_secondary_text(msg)
    dlg.run()
    dlg.destroy()


def confirm_dialog(parent, text, secondary, ok_label):
    dlg = Gtk.MessageDialog(transient_for=parent, modal=True,
                            message_type=Gtk.MessageType.QUESTION,
                            buttons=Gtk.ButtonsType.NONE, text=text)
    dlg.format_secondary_text(secondary)
    dlg.add_button("_Cancel", Gtk.ResponseType.CANCEL)
    btn = dlg.add_button(ok_label, Gtk.ResponseType.OK)
    btn.get_style_context().add_class("destructive-action")
    resp = dlg.run()
    dlg.destroy()
    return resp == Gtk.ResponseType.OK


def clipboard_set_bytes(data, mime):
    """Copy using wl-copy or xclip. Both keep serving the data after Pixtack exits."""
    cmds = []
    if session_is_wayland() and have("wl-copy"):
        cmds.append(["wl-copy", "--type", mime])
    if os.environ.get("DISPLAY") and have("xclip"):
        cmds.append(["xclip", "-selection", "clipboard", "-t", mime, "-i"])
    for cmd in cmds:
        try:
            subprocess.run(cmd, input=data, stdout=DEVNULL, stderr=DEVNULL, timeout=5, check=True)
            return True
        except (OSError, subprocess.SubprocessError):
            continue
    return False


def pixbuf_to_surface(pb):
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, pb.get_width(), pb.get_height())
    cr = cairo.Context(surf)
    Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
    cr.paint()
    return surf


def surface_copy(src):
    dst = cairo.ImageSurface(cairo.FORMAT_ARGB32, src.get_width(), src.get_height())
    cr = cairo.Context(dst)
    cr.set_source_surface(src, 0, 0)
    cr.paint()
    return dst


def norm_rect(p1, p2):
    x, y = min(p1[0], p2[0]), min(p1[1], p2[1])
    return x, y, abs(p2[0] - p1[0]), abs(p2[1] - p1[1])


def paint_blurred(cr, src, x, y, w, h, factor):
    """Paint a heavily blurred copy of src's (x, y, w, h) region onto cr."""
    sw_, sh_ = src.get_width(), src.get_height()
    x0, y0 = max(0, int(x)), max(0, int(y))
    x1, y1 = min(sw_, int(math.ceil(x + w))), min(sh_, int(math.ceil(y + h)))
    w, h = x1 - x0, y1 - y0
    if w < 2 or h < 2:
        return
    factor = max(2, int(factor))
    sw, sh = max(1, w // factor), max(1, h // factor)
    small = cairo.ImageSurface(cairo.FORMAT_ARGB32, sw, sh)
    c = cairo.Context(small)
    c.scale(sw / w, sh / h)
    c.set_source_surface(src, -x0, -y0)
    c.get_source().set_filter(cairo.FILTER_GOOD)
    c.paint()
    cr.save()
    cr.rectangle(x0, y0, w, h)
    cr.clip()
    cr.translate(x0, y0)
    cr.scale(w / sw, h / sh)
    cr.set_source_surface(small, 0, 0)
    pat = cr.get_source()
    pat.set_filter(cairo.FILTER_BILINEAR)
    pat.set_extend(cairo.EXTEND_PAD)
    cr.paint()
    cr.restore()


def desktop_bounds():
    disp = Gdk.Display.get_default()
    geos = [disp.get_monitor(i).get_geometry() for i in range(disp.get_n_monitors())]
    x0 = min(g.x for g in geos)
    y0 = min(g.y for g in geos)
    x1 = max(g.x + g.width for g in geos)
    y1 = max(g.y + g.height for g in geos)
    return x0, y0, x1 - x0, y1 - y0


# --------------------------------------------------------------------------- xdg-desktop-portal

class Portal:
    BUS = "org.freedesktop.portal.Desktop"
    PATH = "/org/freedesktop/portal/desktop"

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.sender = self.bus.get_unique_name()[1:].replace(".", "_")

    @staticmethod
    def token():
        return "pixtack_" + uuid.uuid4().hex[:12]

    def request(self, iface, method, build_args, timeout=300):
        """Call a portal method that answers via a Request.Response signal."""
        tok = self.token()
        handle = "/org/freedesktop/portal/desktop/request/%s/%s" % (self.sender, tok)
        loop = GLib.MainLoop()
        out = {"code": 2, "res": {}, "timed_out": False}

        def on_response(_conn, _sender, _path, _iface, _sig, params, *_):
            out["code"], out["res"] = params.unpack()
            loop.quit()

        def on_timeout():
            out["timed_out"] = True
            loop.quit()
            return False

        sub = self.bus.signal_subscribe(self.BUS, "org.freedesktop.portal.Request", "Response",
                                        handle, None, Gio.DBusSignalFlags.NONE, on_response)
        try:
            self.bus.call_sync(self.BUS, self.PATH, iface, method, build_args(tok),
                               None, Gio.DBusCallFlags.NONE, -1, None)
            tid = GLib.timeout_add_seconds(timeout, on_timeout)
            loop.run()
            if not out["timed_out"]:
                GLib.source_remove(tid)
        finally:
            self.bus.signal_unsubscribe(sub)
        return out["code"], out["res"]

    def get_property(self, iface, name):
        try:
            v = self.bus.call_sync(self.BUS, self.PATH, "org.freedesktop.DBus.Properties", "Get",
                                   GLib.Variant("(ss)", (iface, name)), GLib.VariantType("(v)"),
                                   Gio.DBusCallFlags.NONE, -1, None)
            return v.unpack()[0]
        except GLib.Error:
            return None


def portal_screenshot(interactive=False):
    try:
        portal = Portal()
        code, res = portal.request(
            "org.freedesktop.portal.Screenshot", "Screenshot",
            lambda t: GLib.Variant("(sa{sv})", ("", {
                "handle_token": GLib.Variant("s", t),
                "interactive": GLib.Variant("b", interactive)})))
    except GLib.Error:
        return None
    if code != 0 or not res.get("uri"):
        return None
    path = Gio.File.new_for_uri(res["uri"]).get_path()
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file(path)
    except GLib.Error:
        return None
    # The portal writes its own file; remove it only if it was created just now.
    try:
        if time.time() - os.path.getmtime(path) < 120:
            os.remove(path)
    except OSError:
        pass
    return pb


def capture_desktop():
    """Capture every monitor. Returns (pixbuf, error_message)."""
    if session_is_wayland():
        pb = portal_screenshot(False)
        if pb is not None:
            return pb, None
        for cmd in (["grim"], ["gnome-screenshot", "-f"]):
            if not have(cmd[0]):
                continue
            fd, path = tempfile.mkstemp(prefix="pixtack-", suffix=".png")
            os.close(fd)
            try:
                subprocess.run(cmd + [path], timeout=15, check=True, stdout=DEVNULL, stderr=DEVNULL)
                return GdkPixbuf.Pixbuf.new_from_file(path), None
            except (OSError, subprocess.SubprocessError, GLib.Error):
                pass
            finally:
                try:
                    os.unlink(path)
                except OSError:
                    pass
        return None, ("Could not capture the screen. On Wayland, Pixtack needs "
                      "xdg-desktop-portal (default on Ubuntu) or grim.")
    root = Gdk.get_default_root_window()
    pb = Gdk.pixbuf_get_from_window(root, 0, 0, root.get_width(), root.get_height())
    if pb is None:
        return None, "Could not read the X11 root window."
    return pb, None


def capture_window():
    if session_is_wayland():
        # GNOME/KDE show their own picker where a window can be chosen.
        return portal_screenshot(True), None
    pb, err = capture_desktop()
    if pb is None:
        return None, err
    win = Gdk.Screen.get_default().get_active_window()
    if win is None:
        return pb, None
    r = win.get_frame_extents()
    bx, by, bw, bh = desktop_bounds()
    sx, sy = pb.get_width() / bw, pb.get_height() / bh
    x0 = max(0, int((r.x - bx) * sx))
    y0 = max(0, int((r.y - by) * sy))
    x1 = min(pb.get_width(), int((r.x - bx + r.width) * sx))
    y1 = min(pb.get_height(), int((r.y - by + r.height) * sy))
    if x1 - x0 < 2 or y1 - y0 < 2:
        return pb, None
    return pb.new_subpixbuf(x0, y0, x1 - x0, y1 - y0).copy(), None


# --------------------------------------------------------------------------- region selector

class RegionSelector(Gtk.Window):
    """Fullscreen overlay showing a frozen screenshot; drag to pick a region."""

    def __init__(self, pixbuf, hint, on_done):
        super().__init__(title=APP_NAME + " selection")
        self.src = pixbuf_to_surface(pixbuf)
        self.img_w, self.img_h = pixbuf.get_width(), pixbuf.get_height()
        self.on_done, self.hint = on_done, hint
        self.p0 = self.p1 = None
        self.finished = False
        bx, by, bw, bh = desktop_bounds()
        self.origin = (bx, by)
        self.rx, self.ry = self.img_w / bw, self.img_h / bh

        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        area = Gtk.DrawingArea()
        area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK)
        area.connect("draw", self.on_draw)
        area.connect("button-press-event", self.on_press)
        area.connect("motion-notify-event", self.on_motion)
        area.connect("button-release-event", self.on_release)
        self.area = area
        self.add(area)
        self.connect("key-press-event", self.on_key)
        self.connect("realize", self.on_realize)
        self.fullscreen()
        self.show_all()
        self.present()

    def on_realize(self, *_):
        self.get_window().set_cursor(Gdk.Cursor.new_from_name(self.get_display(), "crosshair"))

    def monitor_geo(self):
        disp = self.get_display()
        gw = self.get_window()
        mon = disp.get_monitor_at_window(gw) if gw else None
        mon = mon or disp.get_primary_monitor() or disp.get_monitor(0)
        return mon.get_geometry()

    def to_img(self, x, y, g):
        return ((g.x - self.origin[0] + x) * self.rx, (g.y - self.origin[1] + y) * self.ry)

    def sel_rect(self):
        if self.p0 is None:
            return None
        return norm_rect(self.p0, self.p1)

    def on_draw(self, widget, cr):
        g = self.monitor_geo()
        cr.save()
        cr.scale(1 / self.rx, 1 / self.ry)
        cr.set_source_surface(self.src, -(g.x - self.origin[0]) * self.rx,
                              -(g.y - self.origin[1]) * self.ry)
        cr.get_source().set_filter(cairo.FILTER_GOOD)
        cr.paint()
        cr.restore()
        W, H = widget.get_allocated_width(), widget.get_allocated_height()
        r = self.sel_rect()
        cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        cr.rectangle(0, 0, W, H)
        if r:
            cr.rectangle(*r)
        cr.set_source_rgba(0, 0, 0, 0.45)
        cr.fill()
        if r:
            cr.set_source_rgb(0.21, 0.52, 0.89)
            cr.set_line_width(2)
            cr.rectangle(r[0] - 1, r[1] - 1, r[2] + 2, r[3] + 2)
            cr.stroke()
            label = "%d × %d" % (round(r[2] * self.rx), round(r[3] * self.ry))
            self._pill(cr, label, r[0], max(0, r[1] - 30))
        else:
            layout = PangoCairo.create_layout(cr)
            layout.set_font_description(Pango.FontDescription.from_string("Sans 13"))
            layout.set_text(self.hint, -1)
            tw = layout.get_pixel_size()[0]
            self._pill(cr, self.hint, (W - tw) / 2 - 12, 40)

    @staticmethod
    def _pill(cr, text, x, y):
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription.from_string("Sans 13"))
        layout.set_text(text, -1)
        tw, th = layout.get_pixel_size()
        cr.set_source_rgba(0, 0, 0, 0.75)
        cr.rectangle(x, y, tw + 24, th + 12)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.move_to(x + 12, y + 6)
        PangoCairo.show_layout(cr, layout)

    def on_press(self, _w, ev):
        if ev.button == 3:
            self.finish(None)
        elif ev.button == 1:
            self.p0 = self.p1 = (ev.x, ev.y)
            self.area.queue_draw()
        return True

    def on_motion(self, _w, ev):
        if self.p0 is not None:
            self.p1 = (ev.x, ev.y)
            self.area.queue_draw()
        return True

    def on_release(self, _w, ev):
        if ev.button != 1 or self.p0 is None:
            return True
        r = self.sel_rect()
        if r[2] < 4 or r[3] < 4:
            self.p0 = self.p1 = None
            self.area.queue_draw()
            return True
        self.finish(self._result(r))
        return True

    def on_key(self, _w, ev):
        name = Gdk.keyval_name(ev.keyval)
        if name == "Escape":
            self.finish(None)
        elif name in ("Return", "KP_Enter", "space"):
            self.finish(self._result(None))
        return True

    def _result(self, r):
        g = self.monitor_geo()
        mx, my = self.to_img(0, 0, g)
        mon = (int(round(mx)), int(round(my)),
               int(round(g.width * self.rx)), int(round(g.height * self.ry)))
        if r is None:
            rect, whole = mon, True
        else:
            x0, y0 = self.to_img(r[0], r[1], g)
            x1, y1 = self.to_img(r[0] + r[2], r[1] + r[3], g)
            x0, y0 = max(0, int(round(x0))), max(0, int(round(y0)))
            x1, y1 = min(self.img_w, int(round(x1))), min(self.img_h, int(round(y1)))
            rect, whole = (x0, y0, x1 - x0, y1 - y0), False
        return {"rect": rect, "monitor": mon, "whole": whole}

    def finish(self, result):
        if self.finished:
            return
        self.finished = True
        self.hide()
        # Give the compositor a moment to remove the overlay before anything is captured.
        GLib.timeout_add(250, self._emit, result)

    def _emit(self, result):
        self.destroy()
        self.on_done(result)
        return False


