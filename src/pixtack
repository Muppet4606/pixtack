class RecorderError(Exception):
    pass


class RecControl(Gtk.Window):
    def __init__(self, rec):
        super().__init__(title="Recording · " + APP_NAME)
        self.rec = rec
        self.set_icon_name("pixtack")
        self.set_keep_above(True)
        self.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.set_border_width(8)
        self.lbl = Gtk.Label()
        self.stop_btn = Gtk.Button(label="Stop")
        self.stop_btn.get_style_context().add_class("destructive-action")
        self.stop_btn.connect("clicked", lambda *_: rec.stop())
        self.discard_btn = Gtk.Button(label="Discard")
        self.discard_btn.connect("clicked", lambda *_: rec.stop(discard=True))
        box.pack_start(self.lbl, False, False, 4)
        box.pack_start(self.stop_btn, False, False, 0)
        box.pack_start(self.discard_btn, False, False, 0)
        self.add(box)
        self.connect("delete-event", lambda *_: (rec.stop(), True)[1])
        self._tick()
        self.show_all()
        GLib.timeout_add(500, self._tick)

    def _tick(self):
        if self.rec.stopping:
            return False
        s = int(time.monotonic() - self.rec.started_at)
        self.lbl.set_markup("<span foreground='#e01b24'>●</span>  %02d:%02d" % (s // 60, s % 60))
        return True

    def set_status(self, text):
        self.lbl.set_text(text)
        self.stop_btn.set_sensitive(False)
        self.discard_btn.set_sensitive(False)
        self.deiconify()
        self.present()

    def place(self, sel):
        """Keep the control out of the recording; minimise it if that is not possible."""
        if session_is_wayland():
            GLib.timeout_add(150, lambda: (self.iconify(), False)[1])
            return False
        w, h = self.get_size()
        mx, my, mw, mh = sel["monitor"]
        rx, ry, rw, rh = sel["rect"]
        m = 16
        for x, y in ((mx + mw - w - m, my + mh - h - 60), (mx + mw - w - m, my + m + 40),
                     (mx + m, my + mh - h - 60), (mx + m, my + m + 40)):
            if x + w < rx or x > rx + rw or y + h < ry or y > ry + rh:
                self.move(x, y)
                return True
        GLib.timeout_add(150, lambda: (self.iconify(), False)[1])
        return False


class Recorder:
    def __init__(self, app, gif):
        self.app, self.gif = app, gif
        self.fps = 15 if gif else 30
        self.tmpdir = tempfile.mkdtemp(prefix="pixtack-")
        ext = "gif" if gif else "mp4"
        self.final = os.path.join(videos_dir(), "Recording_%s.%s" % (stamp(), ext))
        self.proc = self.pipeline = self.session = self.portal = None
        self.pw_fd = None
        self.closed_sub = None
        self.stopping = self.discard = self.finalised = False
        self.started_at = time.monotonic()
        self.sel = None
        self.control = None
        self.raw = None

    # ---- start
    def begin(self, sel):
        self.sel = sel
        try:
            if session_is_wayland():
                self._start_wayland()
            else:
                self._start_x11()
        except RecorderError as e:
            self._cleanup_tmp()
            if str(e):
                error_dialog(str(e))
            self.app.recorder = None
            self.app.release()
            return
        with open(PIDFILE, "w") as fh:
            fh.write(str(os.getpid()))
        self.started_at = time.monotonic()
        self.control = RecControl(self)
        if not self.control.place(sel):
            notify("Recording started",
                   "Stop it from the Pixtack window in the dock, the screen-sharing indicator, "
                   "or run: pixtack --stop")

    def _start_x11(self):
        if not have("ffmpeg"):
            raise RecorderError("Recording needs ffmpeg:\n  sudo apt install ffmpeg")
        x, y, w, h = self.sel["rect"]
        w, h = w - w % 2, h - h % 2
        if w < 16 or h < 16:
            raise RecorderError("The selected area is too small to record.")
        self.raw = os.path.join(self.tmpdir, "raw.mkv")
        if self.gif:
            enc = ["-c:v", "libx264", "-preset", "ultrafast", "-qp", "0"]
        else:
            enc = ["-c:v", "libx264", "-preset", "superfast", "-crf", "23", "-pix_fmt", "yuv420p"]
        cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
               "-f", "x11grab", "-draw_mouse", "1", "-framerate", str(self.fps),
               "-video_size", "%dx%d" % (w, h),
               "-i", "%s+%d,%d" % (os.environ.get("DISPLAY", ":0"), x, y)] + enc + [self.raw]
        self.log = open(os.path.join(self.tmpdir, "ffmpeg.log"), "wb")
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=DEVNULL, stderr=self.log)
        GLib.timeout_add(300, self._watch_proc)

    def _watch_proc(self):
        if self.proc.poll() is None:
            return True
        if not self.stopping:
            self.stopping = True
            notify("Recording failed", self._log_tail())
            error_dialog("ffmpeg stopped unexpectedly:\n" + self._log_tail())
            self.discard = True
        self._finalise()
        return False

    def _log_tail(self):
        try:
            with open(os.path.join(self.tmpdir, "ffmpeg.log"), "rb") as fh:
                return fh.read()[-600:].decode(errors="replace").strip() or "(no output)"
        except OSError:
            return "(no log)"

    def _start_wayland(self):
        try:
            gi.require_version("Gst", "1.0")
            from gi.repository import Gst
        except (ValueError, ImportError):
            raise RecorderError("Recording on Wayland needs GStreamer:\n"
                                "  sudo apt install gir1.2-gstreamer-1.0 gstreamer1.0-pipewire")
        Gst.init(None)
        self.Gst = Gst
        if not Gst.ElementFactory.find("pipewiresrc"):
            raise RecorderError("Recording on Wayland needs the PipeWire GStreamer plugin:\n"
                                "  sudo apt install gstreamer1.0-pipewire")
        if not Gst.ElementFactory.find("vp8enc"):
            raise RecorderError("Missing vp8enc:\n  sudo apt install gstreamer1.0-plugins-good")
        iface = "org.freedesktop.portal.ScreenCast"
        try:
            p = self.portal = Portal()
            code, res = p.request(iface, "CreateSession", lambda t: GLib.Variant("(a{sv})", ({
                "handle_token": GLib.Variant("s", t),
                "session_handle_token": GLib.Variant("s", Portal.token())},)))
            if code != 0:
                raise RecorderError("The screen-cast portal refused to start a session.")
            self.session = res["session_handle"]
            self.closed_sub = p.bus.signal_subscribe(
                Portal.BUS, "org.freedesktop.portal.Session", "Closed", self.session, None,
                Gio.DBusSignalFlags.NONE, lambda *_: self.stop())
            types = (p.get_property(iface, "AvailableSourceTypes") or 1) & 3 or 1
            cursor = p.get_property(iface, "AvailableCursorModes") or 0
            opts = {"types": GLib.Variant("u", types), "multiple": GLib.Variant("b", False)}
            if cursor & 2:
                opts["cursor_mode"] = GLib.Variant("u", 2)

            def sel_args(t):
                o = dict(opts)
                o["handle_token"] = GLib.Variant("s", t)
                return GLib.Variant("(oa{sv})", (self.session, o))

            code, _ = p.request(iface, "SelectSources", sel_args)
            if code != 0:
                raise RecorderError("")
            code, res = p.request(iface, "Start", lambda t: GLib.Variant(
                "(osa{sv})", (self.session, "", {"handle_token": GLib.Variant("s", t)})))
            if code != 0 or not res.get("streams"):
                raise RecorderError("")  # user cancelled the picker
            node = res["streams"][0][0]
            reply, fds = p.bus.call_with_unix_fd_list_sync(
                Portal.BUS, Portal.PATH, iface, "OpenPipeWireRemote",
                GLib.Variant("(oa{sv})", (self.session, {})), GLib.VariantType("(h)"),
                Gio.DBusCallFlags.NONE, -1, None, None)
            self.pw_fd = fds.get(reply.unpack()[0])
        except GLib.Error as e:
            self._close_session()
            raise RecorderError("Screen-cast portal error: %s" % e.message)
        except RecorderError:
            self._close_session()
            raise

        self.raw = os.path.join(self.tmpdir, "raw.webm")
        threads = max(1, min(8, os.cpu_count() or 2))
        rate = 3000000 if self.gif else 8000000
        pipeline = None
        for extra in ("keepalive-time=1000", ""):
            desc = ("pipewiresrc fd=%d path=%d do-timestamp=true %s ! videorate ! "
                    "video/x-raw,framerate=%d/1 ! videoconvert ! queue ! "
                    "vp8enc deadline=1 cpu-used=8 threads=%d target-bitrate=%d ! queue ! "
                    "webmmux ! filesink name=sink" % (self.pw_fd, node, extra, self.fps, threads, rate))
            try:
                pipeline = Gst.parse_launch(desc)
                break
            except GLib.Error:
                continue
        if pipeline is None:
            self._close_session()
            raise RecorderError("Could not build the GStreamer recording pipeline.")
        pipeline.get_by_name("sink").set_property("location", self.raw)
        bus = pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message", self._on_gst_message)
        self.pipeline = pipeline
        if pipeline.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
            self._close_session()
            raise RecorderError("GStreamer could not start recording.")

    def _on_gst_message(self, _bus, msg):
        Gst = self.Gst
        if msg.type == Gst.MessageType.EOS:
            self._gst_done()
        elif msg.type == Gst.MessageType.ERROR:
            err, _dbg = msg.parse_error()
            if not self.stopping and time.monotonic() - self.started_at < 2:
                error_dialog("Recording failed: %s" % err.message)
                self.discard = True
            self.stopping = True
            self._gst_done()

    def _gst_done(self):
        if self.pipeline is None:
            return
        self.pipeline.set_state(self.Gst.State.NULL)
        self.pipeline = None
        if self.pw_fd is not None:
            try:
                os.close(self.pw_fd)
            except OSError:
                pass
            self.pw_fd = None
        self._finalise()

    def _close_session(self):
        if self.portal and self.closed_sub:
            self.portal.bus.signal_unsubscribe(self.closed_sub)
            self.closed_sub = None
        if self.portal and self.session:
            try:
                self.portal.bus.call_sync(Portal.BUS, self.session, "org.freedesktop.portal.Session",
                                          "Close", None, None, Gio.DBusCallFlags.NONE, -1, None)
            except GLib.Error:
                pass
            self.session = None

    # ---- stop
    def stop(self, discard=False):
        if self.stopping:
            return
        self.stopping = True
        self.discard = discard
        if self.control:
            self.control.set_status("Finishing…")
        if self.proc:
            try:
                self.proc.stdin.write(b"q")
                self.proc.stdin.flush()
            except (BrokenPipeError, OSError):
                self.proc.send_signal(signal.SIGINT)
            GLib.timeout_add_seconds(8, self._force_kill)
        elif self.pipeline:
            self.pipeline.send_event(self.Gst.Event.new_eos())
            GLib.timeout_add_seconds(8, lambda: (self._gst_done(), False)[1])

    def _force_kill(self):
        if self.proc and self.proc.poll() is None:
            self.proc.kill()
        return False

    # ---- finish
    def _finalise(self):
        if self.finalised:
            return
        self.finalised = True
        self._close_session()
        try:
            os.remove(PIDFILE)
        except OSError:
            pass
        if self.discard or not self.raw or not os.path.exists(self.raw) \
                or os.path.getsize(self.raw) == 0:
            self._done(None)
            return
        if self.control:
            self.control.set_status("Converting…" if self.gif else "Saving…")
        cmd = self._post_command()
        if cmd is None:
            return
        self.post = subprocess.Popen(cmd, stdout=DEVNULL, stderr=self.log_handle())
        GLib.timeout_add(250, self._watch_post)

    def log_handle(self):
        return open(os.path.join(self.tmpdir, "ffmpeg.log"), "ab")

    def _wayland_crop(self):
        if not session_is_wayland() or self.sel["whole"] or not have("ffprobe"):
            return None
        try:
            out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0",
                                  "-show_entries", "stream=width,height", "-of", "csv=p=0", self.raw],
                                 capture_output=True, text=True, timeout=20).stdout
            vw, vh = [int(v) for v in out.strip().split(",")[:2]]
        except (OSError, subprocess.SubprocessError, ValueError):
            return None
        mx, my, mw, mh = self.sel["monitor"]
        x, y, w, h = self.sel["rect"]
        if abs(vw / vh - mw / mh) > 0.02:
            return None  # a window (or another monitor shape) was picked; keep it whole
        s = vw / mw
        cx, cy = max(0, int((x - mx) * s)), max(0, int((y - my) * s))
        cw, ch = min(vw - cx, int(w * s)), min(vh - cy, int(h * s))
        if cw < 16 or ch < 16:
            return None
        return "crop=%d:%d:%d:%d" % (cw, ch, cx, cy)

    def _post_command(self):
        if not have("ffmpeg"):
            if self.gif:
                kept = os.path.splitext(self.final)[0] + ".webm"
                shutil.move(self.raw, kept)
                self._done(kept, "GIF conversion needs ffmpeg (sudo apt install ffmpeg); kept WebM.")
            else:
                self.final = os.path.splitext(self.final)[0] + ".webm"
                shutil.move(self.raw, self.final)
                self._done(self.final)
            return None
        crop = self._wayland_crop()
        pre = (crop + ",") if crop else ""
        base = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", self.raw]
        if self.gif:
            vf = (pre + "fps=%d,scale='min(iw,1280)':-2:flags=lanczos,split[a][b];"
                  "[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=5"
                  ":diff_mode=rectangle" % self.fps)
            return base + ["-vf", vf, "-loop", "0", self.final]
        if session_is_wayland():
            return base + ["-vf", pre + "scale=trunc(iw/2)*2:trunc(ih/2)*2", "-c:v", "libx264",
                           "-preset", "veryfast", "-crf", "23", "-pix_fmt", "yuv420p",
                           "-movflags", "+faststart", self.final]
        return base + ["-c", "copy", "-movflags", "+faststart", self.final]

    def _watch_post(self):
        if self.post.poll() is None:
            return True
        if self.post.returncode == 0 and os.path.exists(self.final):
            self._done(self.final)
        else:
            kept = os.path.join(videos_dir(), os.path.basename(self.final) + os.path.splitext(self.raw)[1])
            try:
                shutil.move(self.raw, kept)
            except OSError:
                kept = None
            error_dialog("Conversion failed:\n%s\n\nThe raw recording was kept: %s"
                         % (self._log_tail(), kept))
            self._done(None)
        return False

    def _done(self, path, note=""):
        if self.control:
            self.control.destroy()
            self.control = None
        self._cleanup_tmp()
        if path:
            DoneWindow(self.app, path, note)
        self.app.recorder = None
        self.app.release()

    def _cleanup_tmp(self):
        shutil.rmtree(self.tmpdir, ignore_errors=True)


class DoneWindow(Gtk.Window):
    def __init__(self, app, path, note=""):
        super().__init__(title=APP_NAME)
        app.hold()
        self.connect("destroy", lambda *_: app.release())
        self.path = path
        self.set_icon_name("pixtack")
        self.set_resizable(False)
        self.set_keep_above(True)
        size = os.path.getsize(path) / (1024 * 1024)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(14)
        lbl = Gtk.Label(xalign=0)
        lbl.set_markup("<b>Recording saved</b>\n%s  (%.1f MB)%s" % (
            GLib.markup_escape_text(path), size,
            ("\n" + GLib.markup_escape_text(note)) if note else ""))
        lbl.set_selectable(True)
        box.pack_start(lbl, False, False, 0)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        for label, cb in (("Open", self.open_file), ("Show in folder", self.show_folder),
                          ("Copy path", self.copy_path), ("Close", lambda: self.destroy())):
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, f=cb: f())
            row.pack_start(b, True, True, 0)
        box.pack_start(row, False, False, 0)
        self.add(box)
        self.show_all()
        self.present()

    def open_file(self):
        Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(self.path).get_uri(), None)

    def show_folder(self):
        uri = Gio.File.new_for_path(self.path).get_uri()
        try:
            Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
                "org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                "org.freedesktop.FileManager1", "ShowItems", GLib.Variant("(ass)", ([uri], "")),
                None, Gio.DBusCallFlags.NONE, 3000, None)
        except GLib.Error:
            Gio.AppInfo.launch_default_for_uri(
                Gio.File.new_for_path(os.path.dirname(self.path)).get_uri(), None)

    def copy_path(self):
        if not clipboard_set_bytes(self.path.encode(), "text/plain;charset=utf-8"):
            cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            cb.set_text(self.path, -1)
            cb.store()


