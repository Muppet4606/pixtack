    def _build_new_menu(self):
        menu = Gtk.Menu()
        items = [("Retake (F5)", lambda: self.new_capture(self.mode)) if self.mode else None,
                 ("Region", lambda: self.new_capture("region")),
                 ("Full screen", lambda: self.new_capture("full")),
                 ("Active window", lambda: self.new_capture("window")),
                 ("Open image…", self.open_image)]
        for item in items:
            if item is None:
                continue
            mi = Gtk.MenuItem(label=item[0])
            mi.connect("activate", lambda _m, f=item[1]: f())
            menu.append(mi)
        menu.show_all()
        return menu

    def bpx(self):
        """Border width in image pixels (0 when the border is off)."""
        return int(self.border_spin.get_value()) if self.border_chk.get_active() else 0

    def _fit_initial(self):
        disp = Gdk.Display.get_default()
        mon = disp.get_primary_monitor() or disp.get_monitor(0)
        wa = mon.get_workarea()
        self.sf = max(1, mon.get_scale_factor())
        b = 2 * self.bpx()
        w, h = self.base.get_width() + b, self.base.get_height() + b
        self.zoom = min(1.0 / self.sf, wa.width * 0.9 / w, (wa.height * 0.9 - 170) / h)
        self.apply_zoom()
        self.set_default_size(max(900, int(w * self.zoom) + 40), max(420, int(h * self.zoom) + 180))

    def apply_zoom(self):
        b = 2 * self.bpx()
        self.area.set_size_request(int(round((self.base.get_width() + b) * self.zoom)),
                                   int(round((self.base.get_height() + b) * self.zoom)))
        self.area.queue_draw()
        self.update_status()

    def zoom_by(self, f):
        self.zoom = min(8.0, max(0.05, self.zoom * f))
        self.apply_zoom()

    def update_status(self, msg=None):
        if msg is not None:
            self.msg = msg
        b = 2 * self.bpx()
        parts = ["%d × %d" % (self.base.get_width() + b, self.base.get_height() + b),
                 "%d%%" % round(self.zoom * getattr(self, "sf", 1) * 100)]
        if self.msg:
            parts.append(self.msg)
        self.status_lbl.set_text("  ·  ".join(parts))
        self.status_lbl.set_tooltip_text(self.msg or None)

    # ---- model
    def rgba(self):
        c = self.color_btn.get_rgba()
        return (c.red, c.green, c.blue, c.alpha)

    def _render(self, from_index=0):
        """Re-render annotations. While dragging, everything below the moving one is reused."""
        if from_index and self.below is not None and self.below_index == from_index:
            self.cache = surface_copy(self.below)
        else:
            self.cache = surface_copy(self.base)
            cr = cairo.Context(self.cache)
            for op in self.ops[:from_index]:
                self.draw_op(cr, op)
            if from_index:
                self.below, self.below_index = surface_copy(self.cache), from_index
        cr = cairo.Context(self.cache)
        for op in self.ops[from_index:]:
            self.draw_op(cr, op)

    def rebuild(self):
        self.below = None
        self._render(0)
        self.apply_zoom()

    def push_history(self):
        self.undo_stack.append((self.base, list(self.ops)))
        del self.undo_stack[:-100]
        self.redo_stack.clear()
        self.dirty = True
        self.last_edit = None

    def begin_edit(self, i):
        """Snapshot for undo, then give op i a private copy that can be changed freely."""
        self.push_history()
        self.ops[i] = copy.deepcopy(self.ops[i])
        return self.ops[i]

    def coalesced_edit(self, i, kind):
        """Like begin_edit, but repeated small edits (spin clicks, nudges) share one undo step."""
        now = time.monotonic()
        if self.last_edit and self.last_edit[:2] == (i, kind) and now - self.last_edit[2] < 1.5:
            op = self.ops[i]
        else:
            op = self.begin_edit(i)
        self.last_edit = (i, kind, now)
        return op

    def commit(self, op):
        self.push_history()
        self.ops.append(op)
        self.draw_op(cairo.Context(self.cache), op)
        if op["type"] != "eraser":
            self.select(len(self.ops) - 1)
        self.area.queue_draw()

    def _restore(self, state):
        self.base, self.ops = state
        self.sel = None
        self.drag = None
        self.last_edit = None
        self.rebuild()

    def undo(self):
        if self.undo_stack:
            self.redo_stack.append((self.base, list(self.ops)))
            self._restore(self.undo_stack.pop())

    def redo(self):
        if self.redo_stack:
            self.undo_stack.append((self.base, list(self.ops)))
            self._restore(self.redo_stack.pop())

    def transform_ops(self, fn, quarter_turns=0):
        out = []
        for op in self.ops:
            op = copy.deepcopy(op)
            for k in ("p1", "p2", "pos"):
                if k in op:
                    op[k] = fn(op[k])
            if "pts" in op:
                op["pts"] = [fn(p) for p in op["pts"]]
            if op["type"] == "text":
                op["rot"] = (op.get("rot", 0) + quarter_turns) % 4
            out.append(op)
        return out

    def apply_crop(self, x, y, w, h):
        W, H = self.base.get_width(), self.base.get_height()
        x0, y0 = max(0, int(round(x))), max(0, int(round(y)))
        x1, y1 = min(W, int(round(x + w))), min(H, int(round(y + h)))
        if x1 - x0 < 2 or y1 - y0 < 2:
            return
        new = cairo.ImageSurface(cairo.FORMAT_ARGB32, x1 - x0, y1 - y0)
        cr = cairo.Context(new)
        cr.set_source_surface(self.base, -x0, -y0)
        cr.paint()
        ops = self.transform_ops(lambda p: (p[0] - x0, p[1] - y0))
        self.push_history()
        self._restore((new, ops))

    def rotate(self, direction):
        w, h = self.base.get_width(), self.base.get_height()
        new = cairo.ImageSurface(cairo.FORMAT_ARGB32, h, w)
        cr = cairo.Context(new)
        if direction > 0:
            cr.translate(h, 0)
            cr.rotate(math.pi / 2)
            fn = lambda p: (h - p[1], p[0])  # noqa: E731
        else:
            cr.translate(0, w)
            cr.rotate(-math.pi / 2)
            fn = lambda p: (p[1], w - p[0])  # noqa: E731
        cr.set_source_surface(self.base, 0, 0)
        cr.paint()
        ops = self.transform_ops(fn, 1 if direction > 0 else -1)
        self.push_history()
        self._restore((new, ops))

    # ---- selection
    def select(self, i):
        self.sel = i
        self.sync_controls(self.ops[i])
        self.area.queue_draw()

    def deselect(self):
        if self.sel is not None:
            self.sel = None
            self.area.queue_draw()

    def delete_selected(self):
        if self.sel is None:
            return
        self.push_history()
        del self.ops[self.sel]
        self.sel = None
        self.rebuild()

    def sync_controls(self, op):
        """Show the selected annotation's style in the toolbar."""
        self.syncing = True
        try:
            if "color" in op and op["type"] not in ("blur", "eraser"):
                rgba = Gdk.RGBA()
                rgba.red, rgba.green, rgba.blue, rgba.alpha = op["color"]
                self.color_btn.set_rgba(rgba)
            if op["type"] == "blur":
                self.width_spin.set_value(max(1, op["strength"] // 3))
            elif "width" in op and op["type"] != "eraser":
                self.width_spin.set_value(op["width"])
            if op["type"] == "text":
                self.font_spin.set_value(op["size"])
            if op["type"] in ("rect", "ellipse"):
                self.fill_chk.set_active(op["fill"])
        finally:
            self.syncing = False

    def on_style_changed(self, prop):
        if self.syncing or self.sel is None:
            return
        t = self.ops[self.sel]["type"]
        width = self.width_spin.get_value()
        new = {}
        if prop == "color" and t not in ("blur", "eraser"):
            new["color"] = self.rgba()
        elif prop == "width" and t == "blur":
            new["strength"] = max(6, int(width * 3))
        elif prop == "width" and t in ("pen", "line", "arrow", "wave", "rect", "ellipse"):
            new["width"] = width
        elif prop == "font" and t == "text":
            new["size"] = self.font_spin.get_value()
        elif prop == "fill" and t in ("rect", "ellipse"):
            new["fill"] = self.fill_chk.get_active()
        if new:
            self.coalesced_edit(self.sel, prop).update(new)
            self.rebuild()

    def nudge(self, dx, dy):
        op = self.coalesced_edit(self.sel, "nudge")
        orig = copy.deepcopy(op)
        self.shift_op(op, orig, dx, dy)
        self.rebuild()

    @staticmethod
    def shift_op(op, orig, dx, dy):
        for k in ("p1", "p2", "pos"):
            if k in orig:
                op[k] = (orig[k][0] + dx, orig[k][1] + dy)
        if "pts" in orig:
            op["pts"] = [(x + dx, y + dy) for x, y in orig["pts"]]

    @staticmethod
    def resize_op(op, orig, handle, p):
        if handle in ("p1", "p2"):
            op[handle] = p
            return
        x, y, w, h = norm_rect(orig["p1"], orig["p2"])
        x0, y0, x1, y1 = x, y, x + w, y + h
        if "w" in handle:
            x0 = p[0]
        if "e" in handle:
            x1 = p[0]
        if "n" in handle:
            y0 = p[1]
        if "s" in handle:
            y1 = p[1]
        op["p1"], op["p2"] = (x0, y0), (x1, y1)

    def text_size(self, op):
        key = (op["text"], op["size"])
        if key not in self._text_sizes:
            layout = self.text_layout(self._scratch, op)
            self._text_sizes[key] = layout.get_pixel_size()
        return self._text_sizes[key]

    def op_bbox(self, op):
        t = op["type"]
        if "pts" in op:
            xs, ys = [p[0] for p in op["pts"]], [p[1] for p in op["pts"]]
            pad = op["width"] / 2
            return (min(xs) - pad, min(ys) - pad, max(xs) - min(xs) + 2 * pad, max(ys) - min(ys) + 2 * pad)
        if t == "text":
            w, h = self.text_size(op)
            a = op.get("rot", 0) * math.pi / 2
            c, s = round(math.cos(a)), round(math.sin(a))
            x, y = op["pos"]
            pts = [(x + cx * c - cy * s, y + cx * s + cy * c) for cx, cy in ((0, 0), (w, 0), (0, h), (w, h))]
            xs, ys = [p[0] for p in pts], [p[1] for p in pts]
            return (min(xs), min(ys), max(xs) - min(xs), max(ys) - min(ys))
        x, y, w, h = norm_rect(op["p1"], op["p2"])
        if t in ("line", "arrow", "wave"):
            pad = op["width"] / 2 + (max(3.0, op["width"] * 1.6) if t == "wave" else 0)
            return (x - pad, y - pad, w + 2 * pad, h + 2 * pad)
        return (x, y, w, h)

    @staticmethod
    def seg_dist(p, a, b):
        dx, dy = b[0] - a[0], b[1] - a[1]
        if dx == 0 and dy == 0:
            return math.hypot(p[0] - a[0], p[1] - a[1])
        t = max(0.0, min(1.0, ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / (dx * dx + dy * dy)))
        return math.hypot(p[0] - (a[0] + t * dx), p[1] - (a[1] + t * dy))

    def hit(self, op, p):
        t = op["type"]
        if t == "eraser":
            return False
        x, y = p
        tol = op.get("width", 0) / 2 + 6 / self.zoom
        if t in ("text", "blur") or (t == "rect" and op["fill"]):
            bx, by, bw, bh = self.op_bbox(op)
            m = 4 / self.zoom
            return bx - m <= x <= bx + bw + m and by - m <= y <= by + bh + m
        if t == "rect":
            rx, ry, rw, rh = norm_rect(op["p1"], op["p2"])
            outer = rx - tol <= x <= rx + rw + tol and ry - tol <= y <= ry + rh + tol
            inner = rx + tol < x < rx + rw - tol and ry + tol < y < ry + rh - tol
            return outer and not inner
        if t == "ellipse":
            ex, ey, ew, eh = norm_rect(op["p1"], op["p2"])
            rx, ry = max(ew / 2, 1), max(eh / 2, 1)
            r = math.hypot((x - ex - ew / 2) / rx, (y - ey - eh / 2) / ry)
            if op["fill"]:
                return r <= 1 + tol / min(rx, ry)
            return abs(r - 1) * min(rx, ry) <= tol
        if t in ("line", "arrow", "wave"):
            extra = max(3.0, op["width"] * 1.6) if t == "wave" else 0
            return self.seg_dist(p, op["p1"], op["p2"]) <= tol + extra
        if t == "pen":
            pts = op["pts"]
            if len(pts) == 1:
                return math.hypot(x - pts[0][0], y - pts[0][1]) <= tol
            return any(self.seg_dist(p, a, b) <= tol for a, b in zip(pts, pts[1:]))
        return False

    def op_at(self, p, types=None):
        for i in range(len(self.ops) - 1, -1, -1):
            op = self.ops[i]
            if (types is None or op["type"] in types) and self.hit(op, p):
                return i
        return None

    @staticmethod
    def handles(op):
        t = op["type"]
        if t in ("line", "arrow", "wave"):
            return {"p1": op["p1"], "p2": op["p2"]}
        if t in ("rect", "ellipse", "blur"):
            x, y, w, h = norm_rect(op["p1"], op["p2"])
            return {"nw": (x, y), "n": (x + w / 2, y), "ne": (x + w, y), "e": (x + w, y + h / 2),
                    "se": (x + w, y + h), "s": (x + w / 2, y + h), "sw": (x, y + h), "w": (x, y + h / 2)}
        return {}

    def handle_at(self, p):
        if self.sel is None:
            return None
        r = 7 / self.zoom
        for name, (hx, hy) in self.handles(self.ops[self.sel]).items():
            if abs(p[0] - hx) <= r and abs(p[1] - hy) <= r:
                return name
        return None

    def set_cursor(self, name):
        if name == self._cursor_name or not self.area.get_window():
            return
        if name not in self._cursors:
            self._cursors[name] = Gdk.Cursor.new_from_name(self.area.get_display(), name)
        self.area.get_window().set_cursor(self._cursors[name])
        self._cursor_name = name

    def update_cursor(self, p):
        h = self.handle_at(p)
        if h:
            self.set_cursor({"nw": "nwse-resize", "se": "nwse-resize", "ne": "nesw-resize",
                             "sw": "nesw-resize", "n": "ns-resize", "s": "ns-resize",
                             "e": "ew-resize", "w": "ew-resize"}.get(h, "move"))
        elif self.sel is not None and self.hit(self.ops[self.sel], p):
            self.set_cursor("move")
        elif self.tool == "select":
            self.set_cursor("pointer" if self.op_at(p) is not None else "default")
        elif self.tool == "text" and self.op_at(p, ("text",)) is not None:
            self.set_cursor("move")
        else:
            self.set_cursor("text" if self.tool == "text" else "crosshair")

    # ---- rendering
    def draw_op(self, cr, op, preview=False):
        t = op["type"]
        cr.save()
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        if t in ("pen", "eraser"):
            if t == "eraser":
                cr.set_source_surface(self.base, 0, 0)
            else:
                cr.set_source_rgba(*op["color"])
            cr.set_line_width(op["width"])
            pts = op["pts"]
            cr.move_to(*pts[0])
            if len(pts) == 1:
                cr.line_to(pts[0][0] + 0.1, pts[0][1])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.stroke()
        elif t in ("line", "arrow", "wave"):
            (x1, y1), (x2, y2) = op["p1"], op["p2"]
            cr.set_source_rgba(*op["color"])
            cr.set_line_width(op["width"])
            if t == "line":
                cr.move_to(x1, y1)
                cr.line_to(x2, y2)
                cr.stroke()
            elif t == "arrow":
                self._arrow(cr, x1, y1, x2, y2, op["width"])
            else:
                self._wave(cr, x1, y1, x2, y2, op["width"])
        elif t in ("rect", "ellipse"):
            x, y, w, h = norm_rect(op["p1"], op["p2"])
            if t == "rect":
                cr.rectangle(x, y, w, h)
            elif w > 0 and h > 0:
                cr.save()
                cr.translate(x + w / 2, y + h / 2)
                cr.scale(w / 2, h / 2)
                cr.arc(0, 0, 1, 0, 2 * math.pi)
                cr.restore()
            cr.set_source_rgba(*op["color"])
            if op["fill"]:
                cr.fill()
            else:
                cr.set_line_width(op["width"])
                cr.stroke()
        elif t == "blur":
            x, y, w, h = norm_rect(op["p1"], op["p2"])
            paint_blurred(cr, self.cache, x, y, w, h, op["strength"])
            if preview:
                self._dashed(cr, x, y, w, h)
        elif t == "crop":
            x, y, w, h = norm_rect(op["p1"], op["p2"])
            cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
            cr.rectangle(0, 0, self.cache.get_width(), self.cache.get_height())
            cr.rectangle(x, y, w, h)
            cr.set_source_rgba(0, 0, 0, 0.5)
            cr.fill()
            self._dashed(cr, x, y, w, h)
        elif t == "text":
            self._text(cr, op)
        cr.restore()

    def draw_selection(self, cr, op):
        lw = 1 / self.zoom
        cr.save()
        cr.set_line_width(lw)
        blue = (0.21, 0.52, 0.89)
        if op["type"] not in ("line", "arrow", "wave"):
            x, y, w, h = self.op_bbox(op)
            pad = 4 / self.zoom
            cr.set_dash([4 * lw, 3 * lw])
            cr.rectangle(x - pad, y - pad, w + 2 * pad, h + 2 * pad)
            cr.set_source_rgb(*blue)
            cr.stroke()
            cr.set_dash([])
        s = 8 / self.zoom
        for hx, hy in self.handles(op).values():
            cr.rectangle(hx - s / 2, hy - s / 2, s, s)
            cr.set_source_rgb(1, 1, 1)
            cr.fill_preserve()
            cr.set_source_rgb(*blue)
            cr.stroke()
        cr.restore()

    def _dashed(self, cr, x, y, w, h):
        lw = 1.5 / self.zoom
        cr.set_line_width(lw)
        cr.set_dash([6 * lw, 4 * lw])
        cr.rectangle(x, y, w, h)
        cr.set_source_rgb(1, 1, 1)
        cr.stroke_preserve()
        cr.set_dash([6 * lw, 4 * lw], 6 * lw)
        cr.set_source_rgb(0, 0, 0)
        cr.stroke()
        cr.set_dash([])

    @staticmethod
    def _arrow(cr, x1, y1, x2, y2, w):
        length = math.hypot(x2 - x1, y2 - y1)
        if length < 1:
            return
        a = math.atan2(y2 - y1, x2 - x1)
        head = min(max(10.0, w * 4), length)
        half = head * 0.5
        cr.move_to(x1, y1)
        cr.line_to(x2 - head * 0.8 * math.cos(a), y2 - head * 0.8 * math.sin(a))
        cr.stroke()
        hx, hy = x2 - head * math.cos(a), y2 - head * math.sin(a)
        cr.move_to(x2, y2)
        cr.line_to(hx + half * math.sin(a), hy - half * math.cos(a))
        cr.line_to(hx - half * math.sin(a), hy + half * math.cos(a))
        cr.close_path()
        cr.fill()

    @staticmethod
    def _wave(cr, x1, y1, x2, y2, w):
        length = math.hypot(x2 - x1, y2 - y1)
        if length < 1:
            return
        a = math.atan2(y2 - y1, x2 - x1)
        amp = max(3.0, w * 1.6)
        wl = amp * 4
        n = max(2, int(length / 2))
        cr.move_to(x1, y1)
        for i in range(1, n + 1):
            t = length * i / n
            off = amp * math.sin(2 * math.pi * t / wl)
            cr.line_to(x1 + t * math.cos(a) - off * math.sin(a),
                       y1 + t * math.sin(a) + off * math.cos(a))
        cr.stroke()

    @staticmethod
    def text_layout(cr, op):
        layout = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription.from_string("Sans Bold")
        fd.set_absolute_size(op["size"] * Pango.SCALE)
        layout.set_font_description(fd)
        layout.set_text(op["text"], -1)
        return layout

    def _text(self, cr, op):
        layout = self.text_layout(cr, op)
        r, g, b, a = op["color"]
        cr.translate(*op["pos"])
        cr.rotate(op.get("rot", 0) * math.pi / 2)
        cr.move_to(0, 0)
        PangoCairo.layout_path(cr, layout)
        lum = 0.299 * r + 0.587 * g + 0.114 * b
        cr.set_source_rgba(*((0, 0, 0, a * 0.8) if lum > 0.6 else (1, 1, 1, a * 0.8)))
        cr.set_line_width(max(2.0, op["size"] / 8))
        cr.stroke_preserve()
        cr.set_source_rgba(r, g, b, a)
        cr.fill()

    def on_draw(self, _w, cr):
        cr.scale(self.zoom, self.zoom)
        b = self.bpx()
        if b:
            cr.set_source_rgba(*self.border_rgba())
            cr.rectangle(0, 0, self.cache.get_width() + 2 * b, self.cache.get_height() + 2 * b)
            cr.fill()
            cr.translate(b, b)
        cr.set_source_surface(self.cache, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_GOOD if self.zoom < 1.5 else cairo.FILTER_NEAREST)
        cr.paint()
        if self.cur:
            self.draw_op(cr, self.cur, preview=True)
        elif self.sel is not None and self.sel < len(self.ops):
            self.draw_selection(cr, self.ops[self.sel])

    # ---- input
    def to_img(self, x, y):
        b = self.bpx()
        return (x / self.zoom - b, y / self.zoom - b)

    def border_rgba(self):
        c = self.border_color.get_rgba()
        return (c.red, c.green, c.blue, c.alpha)

    def on_tool(self, btn, name):
        if btn.get_active():
            self.tool = name
            self.cur = None
            self._cursor_name = None
            self.area.queue_draw()

    def on_press(self, _w, ev):
        if ev.button != 1:
            return True
        p = self.to_img(ev.x, ev.y)
        if ev.type == DOUBLE_CLICK:
            i = self.op_at(p, ("text",))
            if i is not None:
                self.drag = self.cur = None
                self.select(i)
                self._text_prompt(self.ops[i]["pos"], edit=i)
            return True
        if ev.type != Gdk.EventType.BUTTON_PRESS:
            return True
        # 1. Grab the current selection by a handle or its body.
        if self.sel is not None:
            h = self.handle_at(p)
            if h or self.hit(self.ops[self.sel], p):
                self.start_drag(h or "move", p)
                return True
        # 2. The select tool picks any annotation; the text tool picks existing text.
        if self.tool in ("select", "text"):
            i = self.op_at(p, ("text",) if self.tool == "text" else None)
            if i is not None:
                self.select(i)
                self.start_drag("move", p)
                return True
            if self.tool == "select":
                self.deselect()
                return True
        # 3. Otherwise start a new annotation.
        self.deselect()
        width = self.width_spin.get_value()
        if self.tool == "text":
            self._text_prompt(p)
        elif self.tool in ("pen", "eraser"):
            self.cur = {"type": self.tool, "pts": [p], "color": self.rgba(),
                        "width": width if self.tool == "pen" else max(8.0, width * 3)}
        else:
            self.cur = {"type": self.tool, "p1": p, "p2": p, "color": self.rgba(), "width": width,
                        "fill": self.fill_chk.get_active(), "strength": max(6, int(width * 3))}
        self.area.queue_draw()
        return True

    def start_drag(self, mode, p):
        self.drag = {"mode": mode, "start": p, "index": self.sel,
                     "orig": copy.deepcopy(self.ops[self.sel]), "moved": False}

    def on_motion(self, _w, ev):
        p = self.to_img(ev.x, ev.y)
        if self.drag:
            d = self.drag
            dx, dy = p[0] - d["start"][0], p[1] - d["start"][1]
            if not d["moved"]:
                if math.hypot(dx, dy) * self.zoom < 3:
                    return True
                self.begin_edit(d["index"])
                d["moved"] = True
            op = self.ops[d["index"]]
            if d["mode"] == "move":
                self.shift_op(op, d["orig"], dx, dy)
            else:
                self.resize_op(op, d["orig"], d["mode"], p)
            self._render(d["index"])
            self.area.queue_draw()
            return True
        if not self.cur:
            self.update_cursor(p)
            return False
        if "pts" in self.cur:
            last = self.cur["pts"][-1]
            if math.hypot(p[0] - last[0], p[1] - last[1]) >= 1:
                self.cur["pts"].append(p)
        else:
            if ev.state & Gdk.ModifierType.SHIFT_MASK:
                p = self._constrain(self.cur, p)
            self.cur["p2"] = p
        self.area.queue_draw()
        return True

    @staticmethod
    def _constrain(op, p):
        x1, y1 = op["p1"]
        dx, dy = p[0] - x1, p[1] - y1
        if op["type"] in ("line", "arrow", "wave"):
            step = math.pi / 4
            a = round(math.atan2(dy, dx) / step) * step
            length = math.hypot(dx, dy)
            return (x1 + length * math.cos(a), y1 + length * math.sin(a))
        s = max(abs(dx), abs(dy))
        return (x1 + math.copysign(s, dx), y1 + math.copysign(s, dy))

    def on_release(self, _w, ev):
        if ev.button != 1:
            return False
        if self.drag:
            self.drag = None
            self.below = None
            self.area.queue_draw()
            return True
        if not self.cur:
            return False
        op, self.cur = self.cur, None
        if "p1" in op:
            x, y, w, h = norm_rect(op["p1"], op["p2"])
            if op["type"] in ("line", "arrow", "wave"):
                if math.hypot(w, h) < 3:
                    self.area.queue_draw()
                    return True
            elif w < 2 or h < 2:
                self.area.queue_draw()
                return True
            if op["type"] == "crop":
                self.apply_crop(x, y, w, h)
                return True
        self.commit(op)
        return True

    def on_scroll(self, _w, ev):
        if not ev.state & Gdk.ModifierType.CONTROL_MASK:
            return False
        if ev.direction == Gdk.ScrollDirection.UP:
            self.zoom_by(1.15)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            self.zoom_by(1 / 1.15)
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = ev.get_scroll_deltas()
            if ok and dy:
                self.zoom_by(1.15 if dy < 0 else 1 / 1.15)
        return True

    def _text_prompt(self, p, edit=None):
        pop = Gtk.Popover(relative_to=self.area)
        rect = Gdk.Rectangle()
        b = self.bpx()
        rect.x, rect.y = int((p[0] + b) * self.zoom), int((p[1] + b) * self.zoom)
        rect.width = rect.height = 1
        pop.set_pointing_to(rect)
        pop.set_position(Gtk.PositionType.BOTTOM)
        entry = Gtk.Entry(placeholder_text="Type text, then press Enter")
        entry.set_width_chars(30)
        for side in ("start", "end", "top", "bottom"):
            getattr(entry, "set_margin_" + side)(6)
        if edit is not None:
            entry.set_text(self.ops[edit]["text"])
        pop.add(entry)
        state = {"done": False}

        def finish(commit):
            if state["done"]:
                return
            state["done"] = True
            text = entry.get_text()
            if not commit:
                return
            if edit is None:
                if text.strip():
                    self.commit({"type": "text", "pos": p, "text": text, "color": self.rgba(),
                                 "size": self.font_spin.get_value()})
            elif edit < len(self.ops) and self.ops[edit]["type"] == "text":
                if not text.strip():
                    self.sel = edit
                    self.delete_selected()
                elif text != self.ops[edit]["text"]:
                    self.begin_edit(edit)["text"] = text
                    self.rebuild()

        def on_key(_e, ev):
            if Gdk.keyval_name(ev.keyval) == "Escape":
                finish(False)
                pop.popdown()
                return True
            return False

        entry.connect("activate", lambda *_: (finish(True), pop.popdown()))
        entry.connect("key-press-event", on_key)
        pop.connect("closed", lambda *_: (finish(True), GLib.idle_add(pop.destroy)))
        pop.show_all()
        entry.grab_focus()
        if edit is not None:
            entry.select_region(0, -1)

    def on_key(self, _w, ev):
        if isinstance(self.get_focus(), Gtk.Entry):
            return False
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        shift = ev.state & Gdk.ModifierType.SHIFT_MASK
        name = Gdk.keyval_name(Gdk.keyval_to_lower(ev.keyval)) or ""
        if ctrl:
            actions = {
                "c": self.copy,
                "s": self.save_as if shift else self.save,
                "z": self.redo if shift else self.undo,
                "y": self.redo,
                "Return": lambda: self.copy(close=True),
                "KP_Enter": lambda: self.copy(close=True),
                "plus": lambda: self.zoom_by(1.25), "equal": lambda: self.zoom_by(1.25),
                "KP_Add": lambda: self.zoom_by(1.25),
                "minus": lambda: self.zoom_by(0.8), "KP_Subtract": lambda: self.zoom_by(0.8),
                "0": lambda: (setattr(self, "zoom", 1.0 / self.sf), self.apply_zoom()),
            }
            if name in actions:
                actions[name]()
                return True
            return False
        if self.sel is not None and not self.drag:
            if name in ("Delete", "BackSpace", "KP_Delete"):
                self.delete_selected()
                return True
            step = 10 if shift else 1
            moves = {"Left": (-step, 0), "Right": (step, 0), "Up": (0, -step), "Down": (0, step)}
            if name in moves:
                self.nudge(*moves[name])
                return True
        if name == "Escape":
            if self.cur:
                self.cur = None
                self.area.queue_draw()
            elif self.sel is not None:
                self.deselect()
            else:
                self.close_editor()
            return True
        if name == "F5" and self.mode:
            self.new_capture(self.mode)
            return True
        if name in ("F1", "question"):
            ShortcutsDialog(self)
            return True
        for tool, _g, _t, key in TOOLS:
            if name == key:
                self.tool_buttons[tool].set_active(True)
                return True
        return False

    # ---- output
    def output_surface(self):
        b = self.bpx()
        if not b:
            return self.cache
        out = cairo.ImageSurface(cairo.FORMAT_ARGB32, self.cache.get_width() + 2 * b,
                                 self.cache.get_height() + 2 * b)
        cr = cairo.Context(out)
        cr.set_source_rgba(*self.border_rgba())
        cr.paint()
        cr.set_source_surface(self.cache, b, b)
        cr.paint()
        return out

    def png_bytes(self):
        buf = io.BytesIO()
        self.output_surface().write_to_png(buf)
        return buf.getvalue()

    def copy(self, close=False):
        if clipboard_set_bytes(self.png_bytes(), "image/png"):
            self.gtk_clip = False
        else:
            cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            out = self.output_surface()
            cb.set_image(Gdk.pixbuf_get_from_surface(out, 0, 0, out.get_width(), out.get_height()))
            cb.store()
            self.gtk_clip = True
        self.dirty = False
        self.update_status("Copied to clipboard")
        if close:
            self.destroy()

    def save(self):
        self._write(os.path.join(shots_dir(), "Screenshot_%s.png" % stamp()))

    def save_as(self):
        dlg = Gtk.FileChooserNative.new("Save screenshot", self, Gtk.FileChooserAction.SAVE,
                                        "_Save", "_Cancel")
        dlg.set_do_overwrite_confirmation(True)
        dlg.set_current_folder(shots_dir())
        dlg.set_current_name("Screenshot_%s.png" % stamp())
        for label, pattern in (("PNG image", "*.png"), ("JPEG image", "*.jpg")):
            f = Gtk.FileFilter()
            f.set_name(label)
            f.add_pattern(pattern)
            dlg.add_filter(f)
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            self._write(dlg.get_filename())
        dlg.destroy()

    def _write(self, path):
        ext = os.path.splitext(path)[1].lower()
        src = self.output_surface()
        try:
            if ext in (".jpg", ".jpeg"):
                w, h = src.get_width(), src.get_height()
                rgb = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
                cr = cairo.Context(rgb)
                cr.set_source_rgb(1, 1, 1)
                cr.paint()
                cr.set_source_surface(src, 0, 0)
                cr.paint()
                Gdk.pixbuf_get_from_surface(rgb, 0, 0, w, h).savev(path, "jpeg", ["quality"], ["92"])
            else:
                if ext != ".png":
                    path += ".png"
                src.write_to_png(path)
        except (GLib.Error, OSError, cairo.Error) as e:
            error_dialog("Could not save %s:\n%s" % (path, e), self)
            return
        self.dirty = False
        self.update_status("Saved " + path)

    # ---- lifecycle
    def _confirm_replace(self):
        return not self.dirty or confirm_dialog(
            self, "Discard this screenshot?", "Your edits have not been saved or copied.", "_Discard")

    def new_capture(self, mode):
        if not mode or not self._confirm_replace():
            return
        self.app.capture(mode)
        self.dirty = False
        self.destroy()

    def open_image(self):
        if not self._confirm_replace():
            return
        dlg = Gtk.FileChooserNative.new("Open image", self, Gtk.FileChooserAction.OPEN, "_Open", "_Cancel")
        f = Gtk.FileFilter()
        f.set_name("Images")
        f.add_pixbuf_formats()
        dlg.add_filter(f)
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.ACCEPT else None
        dlg.destroy()
        if path:
            self.app.open_file(path)
            self.dirty = False
            self.destroy()

    def close_editor(self):
        if self.dirty and not confirm_dialog(self, "Close without saving?",
                                             "Your edits have not been saved or copied.", "_Discard"):
            return
        self.destroy()

    def on_delete(self, *_):
        if self.dirty and not confirm_dialog(self, "Close without saving?",
                                             "Your edits have not been saved or copied.", "_Discard"):
            return True
        return False

    def on_destroy(self, *_):
        c = self.rgba()
        cfg = load_config()
        cfg.update({"tool": self.tool if self.tool != "crop" else "arrow",
                    "color": "rgba(%d,%d,%d,%.3f)" % (c[0] * 255, c[1] * 255, c[2] * 255, c[3]),
                    "width": self.width_spin.get_value(), "font": self.font_spin.get_value(),
                    "border_on": self.border_chk.get_active(),
                    "border_width": self.border_spin.get_value(),
                    "border_color": self.border_color.get_rgba().to_string()})
        save_config(cfg)
        if self.gtk_clip:
            self.app.linger_for_clipboard()
        self.app.release()


class ShortcutsDialog(Gtk.Window):
    """Reference for editor keys, plus editable GNOME global shortcuts."""

    EDITOR_KEYS = [
        ("<Ctrl>c", "Copy to clipboard"),
        ("<Ctrl>Return", "Copy and close"),
        ("<Ctrl>s", "Save PNG to Screenshots"),
        ("<Ctrl><Shift>s", "Save as"),
        ("<Ctrl>z", "Undo"),
        ("<Ctrl><Shift>z", "Redo"),
        ("<Ctrl>plus", "Zoom in (or Ctrl+scroll)"),
        ("<Ctrl>minus", "Zoom out"),
        ("<Ctrl>0", "Actual size"),
        ("Delete", "Delete selected annotation"),
        ("Left", "Nudge selection (arrow keys; Shift for 10 px)"),
        ("F5", "Retake"),
        ("F1", "This window"),
        ("Escape", "Cancel drawing, then close"),
    ]

    def __init__(self, parent):
        super().__init__(title="Keyboard shortcuts")
        self.set_transient_for(parent)
        self.set_modal(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_resizable(False)
        self.capturing = None
        self.saved = {}
        self.grab = None
        self.message = ""
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", self.on_destroy)
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24)
        outer.set_border_width(18)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.pack_start(self._heading("Editor"), False, False, 0)
        left.pack_start(self._grid(self.EDITOR_KEYS), False, False, 0)
        left.pack_start(self._heading("Tools"), False, False, 6)
        left.pack_start(self._grid([(k, t.split(" (")[0].split(".")[0]) for _n, _g, t, k in TOOLS]),
                        False, False, 0)
        note = Gtk.Label(xalign=0, label="Hold Shift while drawing for 45° lines, squares and circles.")
        note.get_style_context().add_class("dim-label")
        left.pack_start(note, False, False, 6)
        outer.pack_start(left, False, False, 0)
        outer.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.pack_start(self._heading("Global (work anywhere)"), False, False, 0)
        self.global_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.pack_start(self.global_box, False, False, 0)
        outer.pack_start(right, False, False, 0)
        self.add(outer)
        self._refresh_global()
        self.show_all()
        self.present()

    @staticmethod
    def _heading(text):
        lbl = Gtk.Label(xalign=0)
        lbl.set_markup("<b>%s</b>" % GLib.markup_escape_text(text))
        return lbl

    @staticmethod
    def _grid(rows):
        grid = Gtk.Grid(column_spacing=14, row_spacing=4)
        for i, (accel, desc) in enumerate(rows):
            key = Gtk.ShortcutLabel(accelerator=accel) if accel else Gtk.Label(label="(off)")
            key.set_halign(Gtk.Align.START)
            grid.attach(key, 0, i, 1, 1)
            grid.attach(Gtk.Label(label=desc, xalign=0), 1, i, 1, 1)
        return grid

    def _refresh_global(self):
        for child in self.global_box.get_children():
            child.destroy()
        if not gnome_shortcuts_supported():
            lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=40, label=(
                "Global shortcuts can't be set automatically on this desktop. Add custom shortcuts in "
                "your keyboard settings that run: pixtack --region, --full, --gif or --video."))
            self.global_box.pack_start(lbl, False, False, 0)
            self.global_box.show_all()
            return False
        bindings = gnome_shortcut_bindings()
        grid = Gtk.Grid(column_spacing=14, row_spacing=6)
        for i, (key, name, _arg, _default) in enumerate(SHORTCUTS):
            grid.attach(Gtk.Label(label=name, xalign=0), 0, i, 1, 1)
            btn = Gtk.Button()
            btn.set_size_request(180, -1)
            btn.set_tooltip_text("Click, then press the new keys. Esc cancels, Backspace disables.")
            if self.capturing == key:
                btn.add(Gtk.Label(label="Press new keys…"))
                btn.get_style_context().add_class("suggested-action")
            elif bindings.get(key):
                btn.add(Gtk.ShortcutLabel(accelerator=bindings[key]))
            else:
                off = Gtk.Label(label="Disabled")
                off.get_style_context().add_class("dim-label")
                btn.add(off)
            btn.set_sensitive(self.capturing in (None, key))
            btn.connect("clicked", lambda _b, k=key: self.start_capture(k))
            grid.attach(btn, 1, i, 1, 1)
        self.global_box.pack_start(grid, False, False, 0)

        msg = self.message or "Click a shortcut to change it."
        lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=44, label=msg)
        if not self.message:
            lbl.get_style_context().add_class("dim-label")
        self.global_box.pack_start(lbl, False, False, 4)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        enabled = any(bindings.values())
        toggle = Gtk.Button(label="Disable all" if enabled else "Enable all")
        if not enabled:
            toggle.get_style_context().add_class("suggested-action")
        toggle.connect("clicked", lambda *_: self._toggle_all(enabled))
        reset = Gtk.Button(label="Reset to defaults")
        reset.connect("clicked", lambda *_: self._reset_defaults())
        for b in (toggle, reset):
            b.set_sensitive(self.capturing is None)
            row.pack_start(b, False, False, 0)
        self.global_box.pack_start(row, False, False, 0)
        self.global_box.show_all()
        return False

    def _redraw(self, message=None):
        if message is not None:
            self.message = message
        GLib.idle_add(self._refresh_global)

    def _toggle_all(self, enabled):
        skipped = apply_gnome_shortcuts(remove=enabled) or []
        msg = "Global shortcuts disabled." if enabled else "Global shortcuts enabled."
        if skipped:
            msg += " Skipped: " + "; ".join("%s (key used by '%s')" % s for s in skipped)
        self._redraw(msg)

    def _reset_defaults(self):
        cfg = load_config()
        cfg.pop("global_keys", None)
        save_config(cfg)
        enabled = any(gnome_shortcut_bindings().values())
        skipped = apply_gnome_shortcuts() if enabled else []
        msg = "Defaults restored."
        if skipped:
            msg += " Skipped: " + "; ".join("%s (key used by '%s')" % s for s in skipped)
        self._redraw(msg)

    # ---- recording a new key combination
    def start_capture(self, key):
        if self.capturing:
            return
        self.capturing = key
        self.saved = gnome_shortcut_bindings()
        # Blank Pixtack's own bindings so GNOME doesn't swallow them while we listen.
        for k, b in self.saved.items():
            if b:
                _custom(k).set_string("binding", "")
        Gio.Settings.sync()
        self.grab = None
        try:
            seat = self.get_display().get_default_seat()
            if seat.grab(self.get_window(), Gdk.SeatCapabilities.KEYBOARD, False,
                         None, None, None, None) == Gdk.GrabStatus.SUCCESS:
                self.grab = seat
        except (TypeError, GLib.Error):
            pass
        self._redraw("Press the new keys. Esc cancels, Backspace disables this shortcut.")

    def end_capture(self, binding, cancel=False):
        key, self.capturing = self.capturing, None
        if self.grab:
            self.grab.ungrab()
            self.grab = None
        for k, b in self.saved.items():
            if k != key and b:
                _custom(k).set_string("binding", b)
        name = {k: n for k, n, _a, _d in SHORTCUTS}[key]
        if cancel:
            if self.saved.get(key):
                _custom(key).set_string("binding", self.saved[key])
            msg = "No change."
        elif not binding:
            set_gnome_shortcut(key, None)
            msg = "%s disabled." % name
        else:
            set_gnome_shortcut(key, binding)
            remember_binding(key, binding)
            k, m = Gtk.accelerator_parse(binding)
            msg = "%s set to %s." % (name, Gtk.accelerator_get_label(k, m))
        Gio.Settings.sync()
        self._redraw(msg)

    def on_key(self, _w, ev):
        if not self.capturing:
            if Gdk.keyval_name(ev.keyval) == "Escape":
                self.destroy()
                return True
            return False
        if ev.is_modifier:
            return True
        kv = Gdk.keyval_to_lower(ev.keyval)
        name = Gdk.keyval_name(kv) or ""
        state = ev.state
        try:
            state = Gdk.Keymap.get_for_display(self.get_display()).add_virtual_modifiers(state)
        except (TypeError, AttributeError):
            pass
        mods = int(state) & ACCEL_MASK
        if not mods and name == "Escape":
            self.end_capture(None, cancel=True)
            return True
        if not mods and name == "BackSpace":
            self.end_capture(None)
            return True
        fkey = (name.startswith("F") and name[1:].isdigit()) or name == "Print"
        if not fkey and not (mods & ~int(Gdk.ModifierType.SHIFT_MASK)):
            self._redraw("Include Super, Ctrl or Alt (for example Super+Shift+S). "
                         "Esc cancels, Backspace disables.")
            return True
        accel = Gtk.accelerator_name(kv, Gdk.ModifierType(mods))
        label = Gtk.accelerator_get_label(kv, Gdk.ModifierType(mods))
        own = {k: n for k, n, _a, _d in SHORTCUTS}
        clash = next((own[k] for k, b in self.saved.items()
                      if k != self.capturing and b and _norm(b) == _norm(accel)), None)
        clash = clash and "Pixtack: " + clash
        clash = clash or find_conflict(accel, ignore=list(own))
        if clash:
            self._redraw("%s is already used by '%s'. Try another combination." % (label, clash))
            return True
        self.end_capture(accel)
        return True

    def on_destroy(self, *_):
        if self.capturing:
            self.end_capture(None, cancel=True)


