class Editor(Gtk.Window):
    def __init__(self, app, pixbuf, mode=None):
        super().__init__(title=APP_NAME)
        self.app, self.mode = app, mode
        app.hold()
        self.cfg = load_config()
        self.base = pixbuf_to_surface(pixbuf)
        self.ops, self.undo_stack, self.redo_stack = [], [], []
        self.cache = None
        self.cur = None
        self.zoom = 1.0
        self.tool = self.cfg.get("tool", "arrow")
        self.dirty = False
        self.gtk_clip = False
        self.msg = ""
        self.sel = self.drag = None
        self.below = self.below_index = None
        self.syncing = False
        self.last_edit = None
        self._text_sizes = {}
        self._scratch = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1))
        self._cursors, self._cursor_name = {}, None
        self.set_icon_name("pixtack")
        self._build_ui()
        self.color_btn.connect("color-set", lambda *_: self.on_style_changed("color"))
        self.width_spin.connect("value-changed", lambda *_: self.on_style_changed("width"))
        self.font_spin.connect("value-changed", lambda *_: self.on_style_changed("font"))
        self.fill_chk.connect("toggled", lambda *_: self.on_style_changed("fill"))
        self.rebuild()
        self._fit_initial()
        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", self.on_delete)
        self.connect("destroy", self.on_destroy)
        self.show_all()
        self.present()

    # ---- UI
    def _build_ui(self):
        hb = Gtk.HeaderBar(show_close_button=True)
        hb.props.title = APP_NAME
        self.set_titlebar(hb)

        # Top toolbar, centred: drawing tools, style, border, history and rotate.
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        bar.set_border_width(6)
        bar.set_halign(Gtk.Align.CENTER)
        tools = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        tools.get_style_context().add_class("linked")
        self.tool_buttons, group = {}, None
        for name, glyph, tip, _key in TOOLS:
            b = Gtk.RadioButton.new_with_label_from_widget(group, glyph)
            group = group or b
            b.set_mode(False)
            b.set_tooltip_text(tip)
            b.connect("toggled", self.on_tool, name)
            tools.pack_start(b, False, False, 0)
            self.tool_buttons[name] = b
        bar.pack_start(tools, False, False, 0)
        bar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 2)

        rgba = Gdk.RGBA()
        rgba.parse(self.cfg.get("color", "#e01b24"))
        self.color_btn = Gtk.ColorButton.new_with_rgba(rgba)
        self.color_btn.set_use_alpha(True)
        self.color_btn.set_tooltip_text("Colour")
        bar.pack_start(self.color_btn, False, False, 0)
        bar.pack_start(Gtk.Label(label="Width"), False, False, 0)
        self.width_spin = Gtk.SpinButton.new_with_range(1, 60, 1)
        self.width_spin.set_value(self.cfg.get("width", 4))
        self.width_spin.set_tooltip_text("Line width; also sets blur and eraser strength")
        bar.pack_start(self.width_spin, False, False, 0)
        bar.pack_start(Gtk.Label(label="Font"), False, False, 0)
        self.font_spin = Gtk.SpinButton.new_with_range(8, 300, 2)
        self.font_spin.set_value(self.cfg.get("font", 24))
