        grid.attach(Gtk.Label(label="Width", xalign=0), 0, 1, 1, 1)
        grid.attach(self.border_spin, 1, 1, 1, 1)
        grid.attach(Gtk.Label(label="Colour", xalign=0), 0, 2, 1, 1)
